<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- CombatSnapshotTests calls the native exports through unmanaged function pointers,
         the same entry points ctypes uses. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sts2Emulator\Sts2Emulator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The referee servers' inbox claim has no game types, so it is raced here (RefereeInboxClaimTests). -->
    <Compile Include="..\..\referee\driver\InboxClaim.cs" Link="Referee\InboxClaim.cs" />
    <!-- Which relic flashes the referee records has no game types either (RefereeFlashSourceTests). -->
    <Compile Include="..\..\referee\driver\FlashSource.cs" Link="Referee\FlashSource.cs" />
  </ItemGroup>
</Project>
