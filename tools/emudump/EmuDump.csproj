<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dumps a fresh emulator run as JSON in the referee's terms, for tools/fidelity/run_compare.py. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- An EmuDump call replays tens of fights and exits: TieredPGO's instrumented tier costs more than it gains (measured: 15-25% less CPU without it). -->
    <TieredPGO>false</TieredPGO>
    <!-- JsonArray.Add<T> and the like need the reflection resolver for plain values. The JIT build
         has it on anyway; the NativeAOT build (aot.sh) would turn it off. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\data\id_map.json" Link="id_map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fidelity\power_aliases.json" Link="power_aliases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The invariant and metamorphic checks live with the xunit suite; EmuDump runs them on recorded fights. -->
    <Compile Include="..\..\src\Sts2Emulator.Tests\Support\Invariants\*.cs" LinkBase="Invariants" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sts2Emulator\Sts2Emulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- tools/emudump.Tests reaches the internal replay classes (Fight, Setup) directly. -->
    <InternalsVisibleTo Include="EmuDump.Tests" />
  </ItemGroup>
</Project>
