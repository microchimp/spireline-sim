<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the EmuDump tools that need no game files: the codex replay's walker, the dump, the setup mirror, the state lifecycle. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- SetupPickTests: real referee records (lab batch dense-a), trimmed to the setup items. -->
    <None Include="fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- LifecycleTests' open findings (the known ones on main, each an open defect). -->
    <None Include="lifecycle-open.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\emudump\EmuDump.csproj" />
  </ItemGroup>
</Project>
